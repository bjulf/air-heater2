# Copy to .env and insert the device connection string locally.
IOTHUB_DEVICE_CONNECTION_STRING=

# Receiver ONLY: copy Event Hub-compatible connection string from IoT Hub
# Built-in endpoints, using a separate policy with ServiceConnect permission.
IOTHUB_EVENTHUB_CONNECTION_STRING=
IOTHUB_CONSUMER_GROUP=airheater-postgres
# Local host receiver. Use a libpq DSN; quote/escape password per libpq rules.
AIRHEATER_POSTGRES_DSN=host=127.0.0.1 port=5432 dbname=airheater user=airheater_ingest password=REPLACE_ME

# Docker Compose: choose four independent passwords before first startup.
POSTGRES_PASSWORD=
AIRHEATER_INGEST_PASSWORD=
AIRHEATER_GRAFANA_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Setpoint API on VM ONLY. Dedicated IoT Hub policy with Service Connect only.
# Do not reuse the Event Hubs-compatible or device connection string here.
IOTHUB_SERVICE_CONNECTION_STRING=
AIRHEATER_CONTROL_DEVICE_ID=airheater-sim-1
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Enter this operator token in the Grafana password field; never in dashboard JSON.
AIRHEATER_CONTROL_TOKEN=
AIRHEATER_GRAFANA_ORIGIN=https://iotlab-f5adb6cnhsgka8e8.eno.grafana.azure.com
